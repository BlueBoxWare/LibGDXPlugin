# Tree definition (note that root is optional)
root<fold text=' [1 child] '>
  selector<fold text=' [2 children] '>
    parallel<fold text=' [2 children] '>
      # fdjiojdfio


      care urgentProb:0.8

      # dsjojisd
      #

      org.example.PlayTask # fully qualified task</fold>
    randomSelector<fold text=' [2 children] '>
