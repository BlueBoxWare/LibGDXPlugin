          bark times:"uniform,1,2"
          walk
          mark</fold></fold>
      parallel policy:"selector"  # sleep with random timeout<fold text=' [2 children] '>
        wait seconds:"triangular,2.5,5.5"
        rest</fold></fold></fold></fold>

